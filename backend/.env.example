PORT=4000
JWT_SECRET=doi_chuoi_bi_mat_nay_truoc_khi_trien_khai_that
FRONTEND_URL=http://localhost:5173

# --- Đường dẫn lưu dữ liệu (tuỳ chọn) ---
# Để trống -> dùng backend/data và backend/uploads (mặc định, phù hợp dev).
# Khi deploy lên Railway kèm Volume, trỏ 2 biến này vào đường dẫn mount của Volume
# để dữ liệu (tài khoản, bài học, ảnh...) không bị mất mỗi lần redeploy.
# DATA_DIR=/data
# UPLOAD_DIR=/data/uploads

# --- Lưu trữ file (tuỳ chọn) ---
# Để trống cả khối này -> chạy chế độ lưu ổ đĩa cục bộ (mặc định, dùng cho dev/demo).
# Khai báo ĐỦ 5 biến bên dưới -> tự động chuyển sang Cloudflare R2 (production,
# không tính phí băng thông ra, chịu được nhiều người dùng truy cập đồng thời).
# Xem hướng dẫn tạo bucket/API token trong README.md.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_MEDIA=cocuc-media
# R2_BUCKET_SLIDES=cocuc-slides
# Domain public đã bật "Public Access" cho bucket media (custom domain hoặc pub-xxxx.r2.dev)
# R2_MEDIA_PUBLIC_URL=https://media.hsk360.vn
# Thời gian sống của URL ký cho từng trang PPT, tính bằng giây (mặc định 90)
# R2_SLIDE_URL_TTL=90
